{
  "name": "lifequest",
  "private": true,
  "version": "2.1.0",
  "description": "Ta vie comme un jeu vidéo : quêtes, XP, niveaux, boss et récompenses.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@dicebear/adventurer": "9.4.3",
    "@dicebear/bottts": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@dicebear/fun-emoji": "9.4.3",
    "@dicebear/lorelei": "9.4.3",
    "@dicebear/pixel-art": "9.4.3",
    "@supabase/supabase-js": "2.117.3",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "rollup": "4.64.3"
  }
